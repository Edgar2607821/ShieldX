# ========================
# General API Configuration
# ========================
SHIELDX_TITLE="ShieldX API"
SHIELDX_API_PREFIX="/api/v1"
SHIELDX_HOST="0.0.0.0"
SHIELDX_PORT="20000"
SHIELDX_MONGODB_MAX_RETRIES="5"
SHIELDX_RELOAD="1"
SHIELDX_VERSION="0.1.0"
SHIELDX_CORS_ORIGINS="localhost"
SHIELDX_CORS_ALLOW_CREDENTIALS="1"

# ========================
# ShieldX Client Configuration
# ========================
# ========================
# Database Connection
# ========================
SHIELDX_MONGODB_URI="mongodb://shieldx-db:27017/shieldx"
SHIELDX_MONGO_DATABASE_NAME="shieldx"
SHIELDX_API_IMAGE="nachocode/shieldx:api-0.0.1a2"

# ========================
# Logging Configuration
# ========================
SHIELDX_LOG_PATH="/log"
SHIELDX_LOG_LEVEL="DEBUG"
SHIELDX_LOG_ROTATION_WHEN="m"
SHIELDX_LOG_ROTATION_INTERVAL="10"
SHIELDX_LOG_TO_FILE="1"
SHIELDX_LOG_ERROR_FILE="1"

# ========================
# Mode and Environment
# ========================
SHIELDX_DEBUG="1"
SHIELDX_ENV="dev"
SHIELDX_TEST="1"

# ========================
# API Contact
# ========================
SHIELDX_CONTACT_NAME="Equipo ShieldX"
SHIELDX_CONTACT_EMAIL="soporte@shieldx.io"